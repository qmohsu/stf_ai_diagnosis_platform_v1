# ============================================================================
# STF AI Diagnosis Platform - Local Environment Configuration
# Author: Li-Ta Hsu
# Date: January 2026
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit the real .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Network Configuration (Local-Only)
# ----------------------------------------------------------------------------
BIND_HOST=127.0.0.1
DIAGNOSTIC_API_PORT=8000

# ----------------------------------------------------------------------------
# Postgres Configuration
# ----------------------------------------------------------------------------
POSTGRES_VERSION=0.7.4-pg15
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stf_diagnosis
POSTGRES_USER=stf_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

APP_DB_NAME=stf_diagnosis
APP_DB_USER=stf_app_user
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_HERE

# ----------------------------------------------------------------------------
# Ollama Configuration
# ----------------------------------------------------------------------------
OLLAMA_VERSION=0.1.26
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:27b-q8_0
EMBEDDING_MODEL=nomic-embed-text

# ----------------------------------------------------------------------------
# Diagnostic API Configuration
# ----------------------------------------------------------------------------
DIAGNOSTIC_API_HOST=diagnostic-api
DIAGNOSTIC_API_PORT=8000
DIAGNOSTIC_API_VERSION=0.1.0
DIAGNOSTIC_API_LOG_LEVEL=INFO
DIAGNOSTIC_API_LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Authentication (JWT)
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# Premium LLM Configuration — OpenRouter (opt-in, requires internet)
# NOTE: Some model providers enforce geographic restrictions. The platform
# auto-probes models at startup and hides blocked ones. If a model returns
# 403, the diagnosis endpoint falls back to the next available model.
# See .env.polyu.example for HK-specific guidance.
# ----------------------------------------------------------------------------
PREMIUM_LLM_ENABLED=false
PREMIUM_LLM_API_KEY=
PREMIUM_LLM_BASE_URL=https://openrouter.ai/api/v1
PREMIUM_LLM_MODEL=anthropic/claude-sonnet-4.6
PREMIUM_LLM_CURATED_MODELS=anthropic/claude-opus-4.6,anthropic/claude-sonnet-4.6,google/gemini-3.1-pro-preview,google/gemini-3-flash-preview,openai/gpt-5.2,openai/gpt-5-mini,deepseek/deepseek-v3.2,deepseek/deepseek-chat,qwen/qwen3.5-plus-02-15,qwen/qwen3.5-flash-02-23,minimax/minimax-m2.7,minimax/minimax-m2.5,z-ai/glm-5,z-ai/glm-4.7,moonshotai/kimi-k2.5,moonshotai/kimi-k2

# OBD Agent Configuration (container mode)
# ----------------------------------------------------------------------------
# These vars are used by obd-agent.compose.override.yml.
# For host-mode (virtualenv), use obd_agent/.env instead.
OBD_PORT=sim
OBD_BAUDRATE=115200
VEHICLE_ID=V-SIM-001
OBD_SIM_SCENARIO=misfire
SNAPSHOT_INTERVAL_SECONDS=30

# ============================================================================
# V3 (stf_v3) — real values live ONLY in the server's infra/.env (mode 600).
# Database URLs / JWT secret are required; the model block below shows the
# defaults (vLLM, PROD-09) and the Ollama fallback (runbook §4.4).
# ============================================================================
# STF_V3_DATABASE_URL=postgresql+psycopg://stf_v3:pw@127.0.0.1:5432/stf_v3      # owner role (migrations)
# STF_V3_APP_DATABASE_URL=postgresql+psycopg://stf_v3_app:pw@127.0.0.1:5432/stf_v3
# STF_V3_JWT_SECRET=
# STF_V3_LLM_BASE_URL=http://127.0.0.1:8010/v1        # vLLM (default); Ollama fallback: http://127.0.0.1:11434/v1
# STF_V3_LLM_MODEL=Qwen/Qwen3.6-27B-FP8               # must equal vLLM --served-model-name; Ollama: qwen3.5:27b-q8_0
# STF_V3_LLM_API_KEY=none
# STF_V3_LLM_PROFILE=auto                             # auto | qwen-vllm | qwen-ollama | generic
# STF_V3_LLM_ALLOW_CLOUD=false                        # never true in production (cloud = comparison only)
# STF_V3_CLOUD_LLM_ENABLED=false                      # diagnose_once.py --cloud; key falls back to OPENROUTER_API_KEY
# STF_V3_CLOUD_LLM_MODEL=deepseek/deepseek-v3.2
# STF_V3_DEFAULT_LOCALE=zh-TW
