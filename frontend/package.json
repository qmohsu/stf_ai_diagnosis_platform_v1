{
  "name": "towngas-vehicle-health-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/next-build.cjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bff": "vitest run tests/bff",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:pwa": "playwright test tests/e2e/pwa.spec.ts",
    "lighthouse:portal": "lighthouse http://127.0.0.1:3001 --quiet --chrome-flags=\"--headless --no-sandbox\" --only-categories=accessibility,best-practices,seo --output=json --output-path=lighthouse-report.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "27.0.1",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
